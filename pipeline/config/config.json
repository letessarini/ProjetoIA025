{
  "model": "unet",
  "epochs": 3,
  "batch_size": 4,
  "seed": 20261022,
  "output_dir": "results",
  "checkpoint_name": "last_model.pt",
  "loss_name": "weighted_bce",
  "loss_config": {
    "pos_weight": 1.0
  },
