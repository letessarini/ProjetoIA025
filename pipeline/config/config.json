    "base_channels": 64,
    "depth": 4,
    "padding": true,
    "use_batch_norm": true,
    "dropout": 0.1,
    "activation": "relu",
    "output_activation": "sigmoid",
    "decoder_channels": [256, 128, 64, 32],
    "alpha": 0.3,
    "beta": 0.7
  }
}
